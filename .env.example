# JIRA configuration (required)
# Values can also be provided as files in /run/secrets/<NAME> (see README).
JIRA_SERVER=https://yourcompany.atlassian.net
JIRA_EMAIL=your.email@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT=PROJ

# Optional natural-language project-name vocabulary (for jira_query / digest
# translation). No JIRA round-trip is needed to teach these names.
#
# Extra project keys this tenant queries (space- or comma-separated);
# each also accepts its lower-case form (e.g. ENG also matches "eng").
# JIRA_PROJECT_KEYS=ENG PLT
#
# Human-name aliases as a JSON object mapping a free-text name to a project
# key, e.g. "Support" or "Customer Support" -> SUP.
# JIRA_PROJECT_ALIASES={"Support":"SUP","Customer Support":"SUP"}

# LLM provider configuration
# Set LLM_PROVIDER to one of: vertex, openai, ollama
# If not set, defaults to vertex (requires ANTHROPIC_VERTEX_PROJECT_ID)

# --- Vertex AI (Claude) ---
# LLM_PROVIDER=vertex
# ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project-id
# CLOUD_ML_REGION=us-east5
# LLM_MODEL=claude-sonnet-4-6

# --- OpenAI-compatible API (DeepInfra, OpenAI, vLLM, etc.) ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.deepinfra.com
# LLM_API_KEY=your-api-key
# LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct

# --- Ollama (local or remote) ---
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.1

# --- Confluence (optional, for weekly-status --confluence) ---
# CONFLUENCE_PARENT_PAGE=123456789
